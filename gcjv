*{
    margin: 0px;
    padding: 0px;
    font-family: "Quicksand",sans-serif;
    transition: all .2s linear;
}
.detail{
    margin-top: 120px;
    display: flex;
    
    justify-content: center;
}

.horizontal{
    display: flex;
     align-items: stretch;  /* aligne en haut */
    gap: 40px;        
   
}

.image{
     width: 350px;
    height: 250px;
    overflow: hidden;
    border-radius: 10px;
    
    
}
.image img{
       width: 100%;
    height: 100%;
    object-fit: cover;
 
}

.image img:hover{
        transform: scale(1.1);

}
.vertical{
   width: 500px;
    display: flex;
    flex-direction: column;
}
.top{
    flex: 1; /*  pousse les boutons en bas */
}

button{
   border: none;
    padding: 10px 15px;
    border-radius: 5px;
    cursor: pointer;
 
}
.acheter{
    background-color: pink;
    color: white;
}
.bouton{
    display: flex;
    gap: 10px;
    margin-top: 20px;
     

}
.prix {
  
    margin: 10px 0;
    font-weight: bold;
}
.ajouter {
    background: #ddd;
}







body{
    height: 100vh;
    margin: 0;
    background: white;
    color: white;
    justify-content: center;
    align-items: center;
    font-family: sans-serif;
}

h1 {
    display: flex;
    gap: 5px;
    font-size: 3rem;
}
h1  span{
    display: inline-block;
    animation: ripple 1.2s ease-in-out infinite;
}
h1  span:nth-child(1){
    animation-delay: 0s;
}

h1  span:nth-child(2){animation-delay: 0.1s;}

h1  span:nth-child(3){animation-delay: 0.2s;}
h1  span:nth-child(4){animation-delay: 0.3s;}
h1  span:nth-child(5){animation-delay: 0.4s;}
h1  span:nth-child(6){animation-delay: 0.5s;}
h1  span:nth-child(7){animation-delay: 0.6s;}
h1  span:nth-child(8){animation-delay: 0.7s;}
@keyframes ripple{
    0%,100%{transform:translateY(0);color:white;}
    50%{transform: translateY(-15px) scale(1.2);color: lab(50.56% 48.66 -41.57);}
}
