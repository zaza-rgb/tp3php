*{
    margin: 0px;
    padding: 0px;
    font-family: "Quicksand",sans-serif;
    transition: all .2s linear;
}
.detail{
    margin-top: 120px;
    display: flex;
    
    justify-content: center;
}

.horizontal{
    display: flex;
     align-items: stretch;  /* aligne en haut */
    gap: 40px;        
   
}

.image{
     width: 350px;
    height: 250px;
    overflow: hidden;
    border-radius: 10px;
    
    
}
.image img{
       width: 100%;
    height: 100%;
    object-fit: cover;
 
}

.image img:hover{
        transform: scale(1.1);

}
.vertical{
   width: 500px;
    display: flex;
    flex-direction: column;
}
.top{
    flex: 1; /*  pousse les boutons en bas */
}

button{
   border: none;
    padding: 10px 15px;
    border-radius: 5px;
    cursor: pointer;
 
}
.acheter{
    background-color: pink;
    color: white;
}
.bouton{
    display: flex;
    gap: 10px;
    margin-top: 20px;
     

}
.prix {
  
    margin: 10px 0;
    font-weight: bold;
}
.ajouter {
    background: #ddd;
}